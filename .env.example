# Documentation only: run.py does not load this file automatically.
# Local defaults use an ephemeral secret and HTTP loopback.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Production: set these securely in Render, never commit a real secret.
# ENVIRONMENT=production
# PUBLIC_ORIGIN=https://your-service.onrender.com
# DEMO_SESSION_SECRET=<generate at least 32 random characters>
# Render provides RENDER_EXTERNAL_URL automatically for its hostname.
